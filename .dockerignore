# Repository metadata is not part of image inputs.
.git
/.trae

# macOS cruft
**/.DS_Store

# Host-only Workspace login credential is never an image build input.
/platform/container/workspace/rootfs/home/x/.ssh/workspace_login_key_ed25519
/platform/container/workspace/rootfs/home/x/.ssh/workspace_login_key_ed25519.pub
/platform/macos/rootfs/Users/x/.ssh/codespace/workspace_login_key_ed25519

# Python virtualenvs & caches (regenerated in-image; ~170M of build context)
.venv
**/.venv
**/__pycache__
**/*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
.coverage.*
htmlcov

# Node dependencies are never needed in image build contexts.
**/node_modules

# Build outputs & packages
*.deb
*.tar
*.wsl
Brewfile.lock.json
tmp
