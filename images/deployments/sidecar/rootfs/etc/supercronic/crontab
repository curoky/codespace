# supercronic crontab for the codespace-sidecar image-prewarm task.
# 5-field entries (no user column). Times are interpreted in CRON_TZ.
PATH=/opt/bm/bin:/opt/bm/profile/s6/bin:/usr/bin:/bin
CRON_TZ=Asia/Shanghai

# Pull the hardcoded image list every 10 minutes so containers start from a warm cache.
*/10 * * * * /opt/sidecar/image-pull.sh

# Prune dangling images once a day at 08:00 Asia/Shanghai (UTC+8).
0 8 * * * /opt/sidecar/image-prune.sh
