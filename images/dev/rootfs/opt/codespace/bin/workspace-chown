#!/usr/bin/env bash
# Own the workspace mounts for the development user before anything else runs.
#
# Usage: workspace-chown
#
# 以 root 执行：把 workspace 数据、密文根、upload/cache 与五个持久化 IDE home mount
# 都归属到 5230:5230，供后续以用户 x 运行的服务写入。

set -euo pipefail

for target in \
  /workspace \
  /workspace.enc \
  /upload \
  /cache \
  /home/x/.vscode-server \
  /home/x/.trae \
  /home/x/.trae-cn \
  /home/x/.trae-server \
  /home/x/.trae-cn-server; do
  chown 5230:5230 "${target}"
done
