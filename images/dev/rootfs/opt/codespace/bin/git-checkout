#!/usr/bin/env bash
# Clone a Git repository into one workspace path.
#
# Usage: git-checkout <clone-url> <clone-path>

set -euo pipefail

readonly EMPTY_REPOSITORY_MARKER="codespace-empty-repository"

main() {
  if [[ $# -ne 2 ]]; then
    echo "usage: git-checkout <clone-url> <clone-path>" >&2
    return 2
  fi

  local clone_url=$1
  local target=$2
  local temporary="${target}.codespace-clone"

  if [[ -d "${target}/.git" ]]; then
    if git -C "${target}" rev-parse --verify HEAD >/dev/null 2>&1; then
      return
    fi
    if [[ -f "${target}/.git/${EMPTY_REPOSITORY_MARKER}" ]]; then
      return
    fi
    rm -rf -- "${target}"
  elif [[ -e ${target} ]]; then
    echo "repository target exists but is not a checkout: ${target}" >&2
    return 1
  fi

  mkdir -p -- "$(dirname -- "${target}")"
  rm -rf -- "${temporary}"
  if ! git clone --depth=20 "${clone_url}" "${temporary}"; then
    rm -rf -- "${temporary}"
    return 1
  fi
  if ! git -C "${temporary}" rev-parse --verify HEAD >/dev/null 2>&1; then
    touch "${temporary}/.git/${EMPTY_REPOSITORY_MARKER}"
  fi
  mv -- "${temporary}" "${target}"
}

main "$@"
