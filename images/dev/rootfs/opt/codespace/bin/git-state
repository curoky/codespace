#!/usr/bin/env bash
# Report a checkout's uncommitted and unpushed state as JSON.
#
# Called by the control plane before deleting an environment to warn about work
# that would be lost. Emits {"unpushed": bool, "uncommitted": bool, "detail":
# [...]} with jq handling escaping; a missing checkout reports all-false. detail
# lists dirty + unpushed lines, capped at 20.
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: git-state <target>" >&2
  exit 2
fi

target=$1

emit() {
  jq -n \
    --argjson unpushed "$1" \
    --argjson uncommitted "$2" \
    --args '{unpushed: $unpushed, uncommitted: $uncommitted, detail: $ARGS.positional}' \
    "${@:3}"
}

if [[ ! -d "${target}/.git" ]]; then
  emit false false
  exit 0
fi

mapfile -t dirty < <(git -C "${target}" status --porcelain)
mapfile -t unpushed < <(git -C "${target}" log --branches --not --remotes --oneline)

detail=()
for line in "${dirty[@]}" "${unpushed[@]}"; do
  [[ -n "${line// }" ]] || continue
  detail+=("${line}")
  [[ ${#detail[@]} -ge 20 ]] && break
done

uncommitted=false
[[ ${#dirty[@]} -gt 0 ]] && uncommitted=true
has_unpushed=false
[[ ${#unpushed[@]} -gt 0 ]] && has_unpushed=true

emit "${has_unpushed}" "${uncommitted}" "${detail[@]}"
