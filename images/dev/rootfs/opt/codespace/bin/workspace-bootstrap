#!/usr/bin/env bash
# Bootstrap one workspace from the container environment.
#
# Usage: workspace-bootstrap
#
# Requires Bash, coreutils, and s6-setuidgid.

set -Eeuo pipefail

readonly control_dir="/run/codespace-control"
readonly ready_path="${control_dir}/bootstrap.ready"
readonly failed_path="${control_dir}/bootstrap.failed"
readonly provider_ready_path="${control_dir}/provider-ready"
current_step="configuration"

write_marker() {
  local path=$1
  local content=$2
  local temporary
  temporary=$(mktemp "${path}.XXXXXX")
  printf '%s\n' "${content}" >"${temporary}"
  chmod 0600 "${temporary}"
  mv -f -- "${temporary}" "${path}"
}

settle() {
  exec s6-pause
}

fail() {
  local status=$?
  trap - ERR
  local message="workspace bootstrap ${current_step} failed (${status})"
  write_marker "${failed_path}" "${message}"
  echo "${message}" >&2
  settle
}

require_env() {
  local name=$1
  if [[ -z ${!name-} ]]; then
    echo "${name} is required" >&2
    return 1
  fi
}

run_as_workspace_user() {
  s6-setuidgid x env HOME=/home/x "$@"
}

checkout_repository() {
  require_env CODESPACE_CLONE_URL
  require_env CODESPACE_CLONE_PATH
  current_step="repository checkout"
  run_as_workspace_user timeout --foreground 15m \
    /opt/codespace/bin/git-checkout \
    "${CODESPACE_CLONE_URL}" \
    "${CODESPACE_CLONE_PATH}"
}

main() {
  if [[ $# -ne 0 ]]; then
    echo "usage: workspace-bootstrap" >&2
    return 2
  fi

  trap fail ERR
  # Controller-managed environments set CODESPACE_WORKSPACE_TYPE. Generic image
  # runs have no controller, so idle instead of bootstrapping a workspace.
  if [[ -z ${CODESPACE_WORKSPACE_TYPE-} ]]; then
    echo "CODESPACE_WORKSPACE_TYPE unset; workspace bootstrap idle"
    settle
  fi
  if [[ -f ${ready_path} ]]; then
    settle
  fi
  rm -f -- "${failed_path}"
  require_env CODESPACE_WORKSPACE_TYPE
  require_env CODESPACE_OPEN_PATH

  case ${CODESPACE_WORKSPACE_TYPE} in
    repo)
      current_step="provider authorization"
      while [[ ! -f ${provider_ready_path} ]]; do
        sleep 0.2
      done
      checkout_repository
      ;;
    git)
      checkout_repository
      ;;
    blank) ;;
    *)
      echo "unsupported CODESPACE_WORKSPACE_TYPE: ${CODESPACE_WORKSPACE_TYPE}" >&2
      return 1
      ;;
  esac

  current_step="open path creation"
  run_as_workspace_user mkdir -p -- "${CODESPACE_OPEN_PATH}"
  write_marker "${ready_path}" "ready"
  settle
}

main "$@"
