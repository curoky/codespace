Host *
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes

  # IdentityFile ~/devspace/codespace/controller/assets/ssh/login_key

  # StrictHostKeyChecking no
  # HashKnownHosts no
  UserKnownHostsFile ~/.ssh/known_hosts ~/devspace/dotfiles/ssh/known_hosts

  ServerAliveInterval 10
  ServerAliveCountMax 10000000
  TCPKeepAlive yes

  # HostKeyAlgorithms +ssh-rsa
  # PubkeyAcceptedKeyTypes +ssh-rsa

  ControlMaster auto
  ControlPath ~/.ssh/local-%r@%h:%p
  ControlPersist 4h

  # ObscureKeystrokeTiming no
  # ObsoletePostQuantumKeyExchange no

Host github.com
  # IdentityFile ~/.ssh/github_id_ed25519
	IdentityAgent /Users/x/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
  IdentitiesOnly yes

Host gitlab.com
  # IdentityFile ~/.ssh/gitlab_id_ed25519
	IdentityAgent /Users/x/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
  IdentitiesOnly yes

Host windows
  HostName 192.168.1.77
  User x
  Port 61000
