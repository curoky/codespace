#!/opt/bm/profile/s6/bin/execlineb -P

s6-envdir -Lf -- /run/s6/container_environment

fdmove -c 2 1
redirfd -w 1 /var/log/atuin-service.log

importas -i ATUIN_DB_URI ATUIN_DB_URI
importas -D "127.0.0.1" ATUIN_HOST ATUIN_HOST
importas -D "8002" ATUIN_PORT ATUIN_PORT

export ATUIN_HOST "${ATUIN_HOST}"
export ATUIN_PORT "${ATUIN_PORT}"
export ATUIN_OPEN_REGISTRATION "false"
export ATUIN_DB_URI "${ATUIN_DB_URI}"

foreground { mkdir -p /var/log }

exec /opt/bm/store/atuin/bin/atuin server start
