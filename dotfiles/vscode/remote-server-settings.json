{
  "C_Cpp.clang_format_path": "/opt/sb/store/clang-tools-18/bin/clang-format",
  "C_Cpp.codeAnalysis.maxConcurrentThreads": 32,
  "C_Cpp.codeAnalysis.maxMemory": 50000,
  "C_Cpp.intelliSense.maxCachedProcesses": 120,
  "C_Cpp.intelliSense.maxMemory": 50000,
  "C_Cpp.intelliSenseCacheSize": 51200,
  "C_Cpp.intelliSenseMemoryLimit": 16384,
  "C_Cpp.maxCachedProcesses": 120,
  "C_Cpp.maxConcurrentThreads": 32,
  "C_Cpp.maxMemory": 50000,
  "[cpp]": {
    "editor.tabSize": 2
  },
  "clang-format.executable": "/opt/sb/store/clang-tools-18/bin/clang-format",
  "cmake.cmakePath": "/opt/sb/store/cmake/bin/cmake",
  "cmake.ctestPath": "/opt/sb/store/cmake/bin/ctest",
  "cmakeFormat.exePath": "/nix/var/nix/profiles/default/bin/cmake-format",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,
  "files.trimTrailingWhitespace": false,
  "files.watcherExclude": {
    "**/build64_release/**": true
  },
  "git.path": "/opt/sb/store/git/bin/git",
  "go.alternateTools": {
    // Go SDK
    "go": "/home/x/.nix-profile/bin/go",
    "gofmt": "/home/x/.nix-profile/bin/gofmt",
    // Language Server / Debugger
    "gopls": "/opt/sb/store/gopls/bin/gopls",
    "dlv": "/opt/sb/store/delve/bin/dlv",
    // Code generation / Playground
    "goplay": "/opt/sb/store/goplay/bin/goplay",
    "impl": "/opt/sb/store/impl/bin/impl",
    "gotests": "/opt/sb/store/gotests/bin/gotests",
    // Formatters
    "goimports": "/opt/sb/store/gotools/bin/goimports",
    "gofumpt": "/opt/sb/store/gofumpt/bin/gofumpt",
    // "goformat": "/opt/sb/store/goformat/bin/goformat",
    // Linters
    "staticcheck": "/opt/sb/store/go-tools/bin/staticcheck",
    "golangci-lint": "/opt/sb/store/golangci-lint/bin/golangci-lint",
    "golangci-lint-v2": "/opt/sb/store/golangci-lint/bin/golangci-lint",
    "revive": "/opt/sb/store/revive/bin/revive",
    "golint": "/opt/sb/store/golint/bin/golint"
    // 仅当 "go.formatTool": "custom" 时配置：
    // "customFormatter": "/absolute/path/to/custom-formatter"
  },
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-1.8",
      "path": "/nix/var/nix/profiles/jdk8/lib/openjdk"
    },
    // {
    //   "default": true,
    //   "name": "JavaSE-11",
    //   "path": "/nix/var/nix/profiles/jdk11/lib/openjdk"
    // }
    {
      "default": true,
      "name": "JavaSE-25",
      "path": "/nix/var/nix/profiles/jdk25/lib/openjdk"
    }
  ],
  "java.import.gradle.home": "/nix/var/nix/profiles/default",
  "java.jdt.ls.java.home": "/nix/var/nix/profiles/jdk25/lib/openjdk",
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx16G -Xms4G",
  "java.trace.server": "verbose",
  "markdown-preview-enhanced.pandocPath": "/nix/var/nix/profiles/default/bin/pandoc",
  "prettier.prettierPath": "/opt/sb/store/prettier/libexec/prettier/bin/prettier.cjs",
  "python.defaultInterpreterPath": "/opt/conda/bin/python3",
  // "python.formatting.yapfPath": "/nix/var/nix/profiles/default/bin/yapf",
  "ruby.interpreter.commandPath": "/nix/var/nix/profiles/default/bin/ruby",
  "ruby.pathToBundler": "/nix/var/nix/profiles/default/bin/bundle",
  "ruff.interpreter": [
    "/opt/conda/bin/python3"
  ],
  // "ruby.useBundler": true,
  "shellcheck.executablePath": "/nix/var/nix/profiles/default/bin/shellcheck",
  "typescript.npm": "/home/x/.nix-profile/bin/npm",
  "xml.java.home": "/nix/var/nix/profiles/jdk25/lib/openjdk",
  "xml.server.vmargs": "-Xmx5G",
  "xml.server.binary.path": "/home/x/.nix-profile/bin/lemminx",
  "nix.formatterPath": "/opt/sb/store/nixfmt/bin/nixfmt",
  "nix.serverPath": "/opt/sb/store/nil/bin/nil",
  "nix.enableLanguageServer": true,
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": [
          "/opt/sb/store/nixfmt/bin/nixfmt"
        ]
      }
    }
  },
  "git.autofetch": true,
  "markdown.styles": [
    "/opt/devspace/dotfiles/vscode/markdown-preview.css"
  ]
}
