<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.atuin.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/sb/bin/atuin</string>
        <string>daemon</string>
        <string>start</string>
        <string>--show-logs</string>
        <string>--force</string>
    </array>

    <!-- 登录即启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 退出后自动拉起 -->
    <key>KeepAlive</key>
    <true/>

    <!-- launchd 不继承交互式 shell 的 PATH，显式声明 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/sb/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/atuin.daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/atuin.daemon.log</string>
</dict>
</plist>
