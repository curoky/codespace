<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.atuin.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/sb/bin/atuin</string>
        <string>server</string>
        <string>start</string>
    </array>

    <!-- 登录即启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 退出后自动拉起 -->
    <key>KeepAlive</key>
    <true/>

    <!-- launchd 不继承交互式 shell 的 PATH，显式声明 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/sb/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- 与 codespace sidecar 的 s6 atuin-service 对齐（127.0.0.1:8002，关闭注册） -->
        <key>ATUIN_HOST</key>
        <string>127.0.0.1</string>
        <key>ATUIN_PORT</key>
        <string>8002</string>
        <key>ATUIN_OPEN_REGISTRATION</key>
        <string>false</string>
        <!-- 真实的 Supabase / Postgres 连接串，按需替换 -->
        <key>ATUIN_DB_URI</key>
        <string>postgres://atuin:atuin@localhost/atuin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/atuin.server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/atuin.server.log</string>
</dict>
</plist>
