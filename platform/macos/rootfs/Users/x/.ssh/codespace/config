Include ~/.ssh/codespace/workspaces/*

Host space-*
  BatchMode yes
  ConnectTimeout 10
  ControlMaster no
  ControlPath none
  ControlPersist no
  HostName 127.0.0.1
  User x
  IdentityFile ~/.ssh/codespace/workspace_login_key_ed25519
  IdentitiesOnly yes
  HostKeyAlgorithms ssh-ed25519
  HostKeyAlias codespace
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/codespace/known_hosts/codespace
  UpdateHostKeys no
