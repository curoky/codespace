Host codespace-workspace-*
  ConnectTimeout 10
  ControlMaster no
  ControlPath none
  ControlPersist no
  HostName 127.0.0.1
  User x
  ProxyCommand ~/.ssh/codespace/proxy %n
  IdentityFile ~/.ssh/codespace/login_key
  IdentitiesOnly yes
  HostKeyAlgorithms ssh-ed25519
  HostKeyAlias codespace
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/codespace/known_hosts/codespace
  UpdateHostKeys no
