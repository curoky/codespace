#!/usr/bin/env bash

set -euo pipefail

if (($# != 1)) ||
  [[ ! $1 =~ ^space-[a-z0-9][a-z0-9-]{0,31}-[a-z0-9][a-z0-9-]{0,31}-[a-z0-9][a-z0-9.-]{0,62}$ ]]; then
  printf 'invalid Workspace SSH alias: %s\n' "${1:-}" >&2
  exit 2
fi

if ! response=$(curl --disable --silent --show-error --fail --noproxy '*' \
  --connect-timeout 2 --max-time 30 --write-out '\n%{http_code}' \
  "http://127.0.0.1:8003/api/ssh/$1" </dev/null); then
  printf 'cannot resolve Workspace SSH alias %s; check the local codespace control plane\n' "$1" >&2
  exit 1
fi

if [[ $response != *$'\n200' ]]; then
  printf 'unexpected Workspace SSH route response\n' >&2
  exit 1
fi
route=${response%$'\n200'}
if [[ ! $route =~ ^([a-z0-9][a-z0-9.-]{0,62})\ (2[0-9]{4})$'\n'$ ]]; then
  printf 'invalid Workspace SSH route\n' >&2
  exit 2
fi
host=${BASH_REMATCH[1]}
host_port=${BASH_REMATCH[2]}
if [[ $host == space-* ]]; then
  printf 'Workspace SSH route uses reserved Host prefix: %s\n' "$host" >&2
  exit 2
fi

exec ssh -W "127.0.0.1:${host_port}" "$host"
