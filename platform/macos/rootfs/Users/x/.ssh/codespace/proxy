#!/usr/bin/env bash

set -euo pipefail

if (($# != 1)) ||
  [[ ! $1 =~ ^codespace-workspace-([0-9]{5})_([a-z0-9][a-z0-9.-]{0,62})_[a-z0-9][a-z0-9-]{0,31}_[a-z0-9][a-z0-9-]{0,31}$ ]]; then
  printf 'invalid Workspace SSH alias: %s\n' "${1:-}" >&2
  exit 2
fi

port=${BASH_REMATCH[1]}
host=${BASH_REMATCH[2]}
if ((port < 20000 || port > 29999)); then
  printf 'invalid Workspace SSH port: %s\n' "$port" >&2
  exit 2
fi

exec ssh -W "127.0.0.1:${port}" "$host"
