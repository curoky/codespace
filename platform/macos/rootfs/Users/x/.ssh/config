Include ~/.ssh/codespace/config
# Include ~/.config/colima/ssh_config
Include ~/workspace/devbox2/dotfiles/ssh/big.ssh_config

Host *
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  UserKnownHostsFile ~/.ssh/known_hosts ~/workspace/codespace/platform/container/workspace/rootfs/home/x/.ssh/known_hosts
  ServerAliveInterval 10
  ServerAliveCountMax 10000000
  TCPKeepAlive yes
  ControlMaster auto
  ControlPath ~/.ssh/local-%r@%h:%p
  ControlPersist 4h

Host github.com gitlab.com
  IdentityAgent /Users/x/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

Host windows
  HostName 192.168.1.77
  User x
  Port 61000
