#!/usr/bin/env bash

set -euo pipefail

if [[ ! -c /dev/nvidiactl ]]; then
  exit 0
fi

install -d -o root -g root -m 0755 /var/run/cdi
PATH=/opt/nvidia/nvidia-container-toolkit:/usr/bin:/bin \
  /opt/nvidia/nvidia-container-toolkit/nvidia-ctk \
    cdi generate --output=/var/run/cdi/nvidia.yaml
chmod 0444 /var/run/cdi/nvidia.yaml
