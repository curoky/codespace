#!/usr/bin/env bash

set -euo pipefail

if [[ "${CODESPACE_ROOT_PASSWORD_REQUIRED:-true}" == false ]]; then
  exit 0
fi

# Read user-owned code only after dropping privileges; chpasswd stays root-owned.
# A sentinel preserves trailing newlines so validation cannot silently remove them.
password=$(/usr/local/bin/s6-setuidgid x /usr/local/bin/s6-env HOME=/home/x \
  /home/x/.local/bin/csecret get codespace_root_password && printf '.')
password=${password%.}
if [[ -z "$password" || "$password" == *$'\n'* || "$password" == *$'\r'* ]]; then
  echo "Workspace requires a non-empty, single-line root password in csecret" >&2
  exit 1
fi

printf 'root:%s\n' "$password" | /usr/sbin/chpasswd --crypt-method SHA512
unset password
