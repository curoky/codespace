#!/usr/bin/env bash
set -euo pipefail

main() {
  if (($# != 0)); then
    echo "usage: mount-secret" >&2
    return 2
  fi

  local url="http://codespace-service-secret:8080"

  if grep -q " /opt/secret fuse.rclone " /proc/mounts; then
    echo "secret share already mounted at /opt/secret"
    return 0
  fi

  if /usr/local/store/rclone/bin/rclone mount :webdav: /opt/secret \
    --webdav-url "${url}" \
    --webdav-vendor rclone \
    --allow-other \
    --vfs-cache-mode writes \
    --dir-cache-time 10s \
    --daemon; then
    echo "mounted secret share from ${url} at /opt/secret"
    return 0
  fi

  echo "failed to mount secret share from ${url}; retry with: mount-secret" >&2
  return 1
}

main "$@"
