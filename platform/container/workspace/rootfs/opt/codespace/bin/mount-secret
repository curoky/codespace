#!/usr/bin/env bash
set -euo pipefail

readonly mount_point=/mnt/secret
readonly password_file=/run/secrets/secret_webdav_password
readonly rclone=/opt/bm/store/rclone/bin/rclone

main() {
  if (($# != 0)); then
    echo "usage: mount-secret" >&2
    return 2
  fi

  local url="${CODESPACE_SECRET_URL:-}"
  if [[ -z ${url} ]]; then
    echo "secret mount not configured (CODESPACE_SECRET_URL unset), skipping"
    return 0
  fi

  if [[ ! -r ${password_file} ]]; then
    echo "secret mount password is missing: ${password_file}" >&2
    return 1
  fi
  local password
  password="$(<"${password_file}")"

  if grep -q " ${mount_point} fuse.rclone " /proc/mounts; then
    echo "secret share already mounted at ${mount_point}"
    return 0
  fi

  sudo install -d -o 5230 -g 5230 -m 0755 -- "${mount_point}"

  local obscured
  obscured="$(printf %s "${password}" | "${rclone}" obscure -)"

  if RCLONE_CONFIG_SECRET_TYPE=webdav \
    RCLONE_CONFIG_SECRET_URL="${url}" \
    RCLONE_CONFIG_SECRET_VENDOR=rclone \
    RCLONE_CONFIG_SECRET_USER=codespace \
    RCLONE_CONFIG_SECRET_PASS="${obscured}" \
    "${rclone}" mount secret: "${mount_point}" \
      --allow-other \
      --vfs-cache-mode writes \
      --dir-cache-time 10s \
      --daemon; then
    echo "mounted secret share from ${url} at ${mount_point}"
    return 0
  fi

  echo "failed to mount secret share from ${url}; retry with: mount-secret" >&2
  return 1
}

main "$@"
