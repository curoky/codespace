#!/usr/bin/env bash
# Clone a Git repository into one Workspace path.
#
# Usage: checkout <clone-url> <checkout-path> [git-clone-arg ...]

set -euo pipefail

readonly EMPTY_REPOSITORY_MARKER="codespace-empty-repository"

main() {
  if [[ $# -lt 2 ]]; then
    echo "usage: checkout <clone-url> <checkout-path> [git-clone-arg ...]" >&2
    return 2
  fi

  local clone_url=$1
  local target=$2
  local temporary="${target}.codespace-clone"
  local -a clone_command=(git clone)
  if [[ $# -gt 2 ]]; then
    clone_command+=("${@:3}")
  fi
  clone_command+=(-- "${clone_url}" "${temporary}")

  if [[ -d "${target}/.git" ]]; then
    if git -C "${target}" rev-parse --verify HEAD >/dev/null 2>&1; then
      return
    fi
    if [[ -f "${target}/.git/${EMPTY_REPOSITORY_MARKER}" ]]; then
      return
    fi
    rm -rf -- "${target}"
  elif [[ -e ${target} ]]; then
    echo "repository target exists but is not a checkout: ${target}" >&2
    return 1
  fi

  mkdir -p -- "$(dirname -- "${target}")"
  rm -rf -- "${temporary}"
  if ! "${clone_command[@]}"; then
    rm -rf -- "${temporary}"
    return 1
  fi
  if ! git -C "${temporary}" rev-parse --verify HEAD >/dev/null 2>&1; then
    touch "${temporary}/.git/${EMPTY_REPOSITORY_MARKER}"
  fi
  mv -- "${temporary}" "${target}"
}

main "$@"
