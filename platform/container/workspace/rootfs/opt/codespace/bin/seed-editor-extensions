#!/usr/bin/env bash
# Seed each persistent IDE cache once. After initialization the IDE owns its
# manifest; container recreation must not reinstall extensions the user removed.
set -euo pipefail

readonly template=/opt/codespace/share/editor-extensions

for server in .vscode-server .trae-server .trae-cn-server; do
  target="/cache/$server/extensions"
  [[ -f "$target/extensions.json" ]] && continue

  # Publish the prebuilt manifest last, so interrupted copies can be retried.
  cp -R "$template/extensions/." "$target/"
  cp "$template/$server.json" "$target/.extensions.json"
  mv "$target/.extensions.json" "$target/extensions.json"
done
