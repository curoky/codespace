#!/usr/bin/env bash
# workspace-init s6 oneshot (runs as x): prepare private data directories
# and mount /workspace via gocryptfs when explicitly enabled.

set -euo pipefail

case "${CODESPACE_ENCRYPTED:?CODESPACE_ENCRYPTED must be true or false}" in
  true | false) ;;
  *)
    echo "CODESPACE_ENCRYPTED must be true or false" >&2
    exit 1
    ;;
esac
readonly encrypted_path=/workspace.enc

# Rootful Podman preserves Host IDs. Keep the Host login user as owner for SSH
# access and grant the container user group write access for the Agent socket.
sudo mkdir -p -- /run/codespace-control
sudo chgrp 5230 -- /run/codespace-control
sudo chmod 0730 -- /run/codespace-control
sudo install -d -o 5230 -g 5230 -m 0700 -- /workspace "${encrypted_path}" /upload

if [[ ${CODESPACE_ENCRYPTED} == false ]]; then
  echo "Workspace encryption disabled, using plaintext /workspace"
  exit 0
fi

# gocryptfs 以 x 挂载：其 FUSE 守护进程用 x 身份读写密文根，落盘密文属主即 5230:5230。
readonly workspace_key_file=/run/secrets/codespace_workspace_key
if [[ ! -r ${workspace_key_file} ]]; then
  echo "Encrypted Workspace requires a readable key secret" >&2
  exit 1
fi
printf -v workspace_key_command 'cat -- %q' "${workspace_key_file}"

if grep -q " /workspace fuse.gocryptfs " /proc/mounts; then
  echo "gocryptfs already mounted at /workspace"
  exit 0
fi

if [[ ! -e ${encrypted_path}/gocryptfs.conf ]]; then
  gocryptfs -init -extpass "${workspace_key_command}" "${encrypted_path}"
fi

gocryptfs -extpass "${workspace_key_command}" -allow_other "${encrypted_path}" /workspace
