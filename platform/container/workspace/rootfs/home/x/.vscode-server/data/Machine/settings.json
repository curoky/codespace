{
  "[cpp]": {
    "editor.tabSize": 2
  },
  "C_Cpp.clang_format_path": "/usr/local/profile/clang-tools/bin/clang-format",
  "C_Cpp.codeAnalysis.maxConcurrentThreads": 32,
  "C_Cpp.codeAnalysis.maxMemory": 50000,
  "C_Cpp.intelliSense.maxCachedProcesses": 120,
  "C_Cpp.intelliSense.maxMemory": 50000,
  "C_Cpp.intelliSenseCacheSize": 51200,
  "C_Cpp.intelliSenseMemoryLimit": 16384,
  "C_Cpp.maxCachedProcesses": 120,
  "C_Cpp.maxConcurrentThreads": 32,
  "C_Cpp.maxMemory": 50000,
  "chat.permissions.default": "autoApprove",
  "clang-format.executable": "/usr/local/profile/clang-tools/bin/clang-format",
  "cmake.cmakePath": "/usr/local/store/cmake/bin/cmake",
  "cmake.ctestPath": "/usr/local/store/cmake/bin/ctest",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,
  "files.trimTrailingWhitespace": false,
  "files.watcherExclude": {
    "**/build64_release/**": true
  },
  "git.autofetch": true,
  "git.path": "/usr/local/store/git/bin/git",
  "go.alternateTools": {
    "dlv": "/usr/local/profile/go/bin/dlv",
    "go": "/opt/go/go1.27.1/bin/go",
    "gofmt": "/opt/go/go1.27.1/bin/gofmt",
    "gofumpt": "/usr/local/profile/go/bin/gofumpt",
    "goimports": "/usr/local/profile/go/bin/goimports",
    "golangci-lint": "/usr/local/profile/go/bin/golangci-lint",
    "golangci-lint-v2": "/usr/local/profile/go/bin/golangci-lint",
    "gopls": "/usr/local/profile/go/bin/gopls",
    "gotests": "/usr/local/profile/go/bin/gotests",
    "impl": "/usr/local/profile/go/bin/impl",
    "revive": "/usr/local/profile/go/bin/revive",
    "staticcheck": "/usr/local/profile/go/bin/staticcheck"
  },
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-1.8",
      "path": "/opt/java/openjdk8"
    },
    {
      "default": true,
      "name": "JavaSE-27",
      "path": "/opt/java/openjdk27"
    }
  ],
  "java.jdt.ls.java.home": "/opt/java/openjdk27",
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx16G -Xms4G",
  "java.trace.server": "verbose",
  "nix.enableLanguageServer": true,
  "nix.formatterPath": "/usr/local/store/nixfmt/bin/nixfmt",
  "nix.serverPath": "/usr/local/store/nil/bin/nil",
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": [
          "/usr/local/store/nixfmt/bin/nixfmt"
        ]
      }
    }
  },
  "prettier.prettierPath": "/opt/node/tools/envs/prettier/node_modules/prettier",
  "python.defaultInterpreterPath": "/opt/uv/python/cpython-3.14-linux-x86_64-gnu/bin/python3.14",
  "ruff.interpreter": [
    "/opt/uv/python/cpython-3.14-linux-x86_64-gnu/bin/python3.14"
  ],
  "shellcheck.executablePath": "/usr/local/bin/shellcheck",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "icon": "terminal-bash",
      "path": "/usr/bin/bash"
    },
    "zsh": {
      "path": "/usr/local/bin/zsh"
    }
  },
  "typescript.npm": "/opt/node/nodejs24/bin/npm",
  "xml.java.home": "/opt/java/openjdk27",
  "xml.server.binary.path": "/opt/java/tools/bin/lemminx",
  "xml.server.vmargs": "-Xmx5G"
}
