#!/bin/sh

set -eu

if [ "${CODESPACE_ROOT_PASSWORD_REQUIRED:-true}" = false ]; then
  exit 0
fi

secret=/run/secrets/codespace_root_password
if [ ! -s "$secret" ]; then
  echo "Workspace requires a non-empty root password secret" >&2
  exit 1
fi

IFS= read -r password <"$secret" || [ -n "$password" ]
printf 'root:%s\n' "$password" | chpasswd
unset password
