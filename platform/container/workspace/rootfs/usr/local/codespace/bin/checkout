#!/usr/bin/env bash

set -euo pipefail

readonly EMPTY_REPOSITORY_MARKER="codespace-empty-repository"

main() {
  if [[ $# -lt 2 ]]; then
    echo "usage: checkout <clone-url> <checkout-path> [git-clone-arg ...]" >&2
    return 2
  fi

  local clone_url=$1
  local target=$2
  local temporary="${target}.codespace-clone"

  if [[ -d "${target}/.git" ]]; then
    if git -C "${target}" rev-parse --verify HEAD >/dev/null 2>&1; then
      return
    fi
    if [[ -f "${target}/.git/${EMPTY_REPOSITORY_MARKER}" ]]; then
      return
    fi
    echo "repository target is not a reusable checkout: ${target}" >&2
    return 1
  elif [[ -e ${target} ]]; then
    echo "repository target exists but is not a checkout: ${target}" >&2
    return 1
  fi

  mkdir -p -- "$(dirname -- "${target}")"
  rm -rf -- "${temporary}"
  if ! git clone "${@:3}" -- "${clone_url}" "${temporary}"; then
    rm -rf -- "${temporary}"
    return 1
  fi
  if ! git -C "${temporary}" rev-parse --verify HEAD >/dev/null 2>&1; then
    touch "${temporary}/.git/${EMPTY_REPOSITORY_MARKER}"
  fi
  mv -- "${temporary}" "${target}"
}

main "$@"
