# Prefer browser-renderable text types for developer files served by rclone.
text/plain			txt text log conf cfg ini toml env properties lock
text/markdown			md markdown
text/yaml			yaml yml
text/csv			csv tsv
text/x-python			py pyi pyx
text/x-shellscript		sh bash zsh fish
text/x-go			go
text/x-rust			rs
text/x-c			c h
text/x-c++			cc cpp cxx hh hpp hxx
text/x-java-source		java
text/x-kotlin			kt kts
text/x-swift			swift
text/x-ruby			rb
text/x-perl			pl pm
text/x-lua			lua
text/x-sql			sql
text/x-diff			diff patch
text/javascript			js mjs cjs jsx ts tsx
application/json		json jsonl
