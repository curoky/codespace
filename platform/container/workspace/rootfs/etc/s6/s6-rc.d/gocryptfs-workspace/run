#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.gocryptfs-workspace.log
fdmove -c 2 1

backtick -n -D false CODESPACE_ENCRYPTED { cat /run/s6/container_environment/CODESPACE_ENCRYPTED }
importas -u CODESPACE_ENCRYPTED CODESPACE_ENCRYPTED

# 以 root 校验加密模式并准备外部挂载点；install 只改挂载根，绝不递归改写持久数据。
ifelse -n
{
  ifelse { eltest "${CODESPACE_ENCRYPTED}" = true } { true }
  eltest "${CODESPACE_ENCRYPTED}" = false
}
{
  foreground { echo "CODESPACE_ENCRYPTED must be true or false" }
  exit 1
}
# 明文 Project 无需加密挂载；用 s6-pause 保持 longrun 就绪，让依赖 /workspace 的
# 服务在两种模式下都能安全依赖本 service，而不会触发 s6 重启风暴。
# 检查恒真会立即向 notification-fd 发就绪，避免依赖方一直等到 timeout-up。
ifelse { eltest "${CODESPACE_ENCRYPTED}" != true }
{
  foreground { install -d -o 5230 -g 5230 -m 0700 -- /workspace }
  foreground { echo "Workspace encryption disabled, using plaintext /workspace" }
  s6-notifyoncheck -d -n 0 -w 100 -t 2000 -T 60000 -c "true"
  exec s6-pause
}

# idmapped bind 在容器内把 Host 5230:5230 映射为 1001:1001；FUSE 明文视图
# 对 x 强制呈现为 5230:5230。
if { install -d -o 1001 -g 1001 -m 0700 -- /workspace /workspace.enc }
if
{
  s6-applyuidgid -u 1001 -g 1001 -G ""
  test -r /run/secrets/codespace_workspace_key
}

# 首次启动时初始化密文根；init 是一次性命令，放进 if 块内既隔离降权又能跑完后继续。
# 这里用 s6-applyuidgid 按 uid/gid 降权，让 readiness notifier 在服务正式降权前注册。
if
{
  ifelse { eltest -e /workspace.enc/gocryptfs.conf } { true }
  s6-applyuidgid -u 1001 -g 1001 -G ""
  /usr/local/store/gocryptfs/bin/gocryptfs -init
    -extpass "cat -- /run/secrets/codespace_workspace_key" /workspace.enc
}

s6-notifyoncheck -d -n 0 -w 1000 -t 2000 -T 60000
  -c "grep -qe /workspace.fuse[.]gocryptfs /proc/mounts"
s6-applyuidgid -u 1001 -g 1001 -G ""
exec /usr/local/store/gocryptfs/bin/gocryptfs
  -fg -extpass "cat -- /run/secrets/codespace_workspace_key"
  -allow_other -force_owner 5230:5230
  /workspace.enc /workspace
