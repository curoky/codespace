#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.atuin-server.log
fdmove -c 2 1

if { test -s /run/secrets/atuin_db_uri }
backtick -i ATUIN_DB_URI { cat /run/secrets/atuin_db_uri }

s6-notifyoncheck -d -n 0 -w 1000 -t 2000 -T 60000
  -c "/usr/local/store/curl/bin/curl --noproxy * --fail --silent --output /dev/null --max-time 2 http://127.0.0.1:8002/"
s6-setuidgid x
s6-env HOME=/home/x
s6-env ATUIN_HOST=127.0.0.1
s6-env ATUIN_PORT=8002
s6-env ATUIN_OPEN_REGISTRATION=false
exec /usr/local/store/atuin/bin/atuin server start
