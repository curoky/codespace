#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.rclone-webdav.log
fdmove -c 2 1

s6-setuidgid x
s6-env HOME=/home/x
exec /usr/local/store/rclone/bin/rclone serve webdav files:
  --config /etc/rclone.conf
  --addr 127.0.0.1:8004
  --disable-dir-list
  --disable-zip
  --dir-cache-time 0
  --poll-interval 0
  --stats 0
