#!/opt/bm/profile/s6/bin/execlineb -P

# Tunables (OLLAMA_HOST, OLLAMA_MODELS, OLLAMA_KEEP_ALIVE, ...) come from the
# container environment; see `ollama serve --help`.
s6-envdir -Lf -- /run/s6/container_environment

redirfd -w 1 /var/log/s6.ollama.log
fdmove -c 2 1

# Bind loopback by default like the other workspace listeners; port 8006
# continues the 800x scheme (8002 atuin, 8004 rclone WebDAV, 8005 copyparty,
# 8007 rclone HTTP). Callers can still override OLLAMA_HOST for bridge exposure.
importas -D 127.0.0.1:8006 OLLAMA_HOST OLLAMA_HOST
export OLLAMA_HOST ${OLLAMA_HOST}

exec ollama serve
