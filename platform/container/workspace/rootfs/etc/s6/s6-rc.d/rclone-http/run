#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.rclone-http.log
fdmove -c 2 1

s6-setuidgid x
s6-env HOME=/home/x
exec /usr/local/store/rclone/bin/rclone serve http files:
  --config /etc/rclone.conf
  --addr 127.0.0.1:8007
  --response-header "Content-Disposition: inline"
  --disable-zip
  --dir-cache-time 0
  --poll-interval 0
  --stats 0
