#!/usr/local/bin/execlineb -P

# Keep the atuin client sync daemon in the foreground so s6 owns its lifecycle
# instead of relying on atuin autostart.
redirfd -w 1 /var/log/s6.atuin-daemon.log
fdmove -c 2 1

s6-setuidgid x
s6-env HOME=/home/x
exec /usr/local/store/atuin/bin/atuin daemon start --show-logs --force
