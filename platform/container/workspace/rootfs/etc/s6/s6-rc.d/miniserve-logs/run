#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.miniserve-logs.log
fdmove -c 2 1

backtick -D 127.0.0.1 MINISERVE_INTERFACES { cat /run/s6/container_environment/MINISERVE_INTERFACES }
importas -u MINISERVE_INTERFACES MINISERVE_INTERFACES

s6-setuidgid x
s6-env HOME=/home/x
s6-env MINISERVE_ENABLE_TAR=false
s6-env MINISERVE_ENABLE_TAR_GZ=false
s6-env MINISERVE_ENABLE_ZIP=false
s6-env MINISERVE_SHOW_SYMLINK_INFO=false
s6-env MINISERVE_SHOW_WGET_FOOTER=false
exec /usr/local/store/miniserve/bin/miniserve
  --interfaces ${MINISERVE_INTERFACES}
  --port 8008
  --no-symlinks
  --dirs-first
  --title codespace-logs
  --hide-version-footer
  --hide-theme-selector
  /var/log
