#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.gh-login.log
fdmove -c 2 1
if { test -s /run/secrets/github_action_token }
s6-setuidgid x
s6-env HOME=/home/x
redirfd -r 0 /run/secrets/github_action_token
/usr/local/store/gh/bin/gh auth login
  --hostname github.com
  --git-protocol ssh
  --skip-ssh-key
  --insecure-storage
  --with-token
