#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.gh-login.log
fdmove -c 2 1
s6-setuidgid x
s6-env HOME=/home/x
pipeline { /home/x/.local/bin/csecret get github_token_public_read }
/usr/local/store/gh/bin/gh auth login
  --hostname github.com
  --git-protocol ssh
  --skip-ssh-key
  --insecure-storage
  --with-token
