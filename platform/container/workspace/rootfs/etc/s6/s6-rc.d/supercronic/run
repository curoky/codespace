#!/usr/local/bin/execlineb -P

# The crontab (/etc/supercronic/crontab) ships empty; supercronic keeps running
# with zero jobs. Add 5-field entries there to schedule work.

redirfd -w 1 /var/log/s6.supercronic.log
fdmove -c 2 1
s6-setuidgid x
s6-env HOME=/home/x
exec /usr/local/store/supercronic/bin/supercronic /etc/supercronic/crontab
