#!/usr/bin/env bash

set -euo pipefail

script_dir="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" = init ]; then
  if [ "$#" -ne 1 ]; then
    printf 'usage: %s init\n' "$0" >&2
    exit 1
  fi
  exec env -u VIRTUAL_ENV UV_PROJECT_ENVIRONMENT="$script_dir/.venv" \
    uv sync --project "$script_dir" --locked --no-dev --python 3.14
fi
if [ ! -x "$script_dir/.venv/bin/python" ]; then
  printf 'error: Python environment is not initialized; run "%s init" first\n' "$0" >&2
  exit 1
fi
exec "$script_dir/.venv/bin/python" "$script_dir/java-tool.py" "$@"
