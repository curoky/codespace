#!/usr/local/bin/execlineb -P


redirfd -w 1 /var/log/s6.nginx.log
fdmove -c 2 1

s6-notifyoncheck -d -n 0 -w 1000 -t 2000 -T 30000
  -c "/usr/bin/curl --noproxy * --fail --silent --output /dev/null --max-time 2 http://127.0.0.1:8080/healthz"
s6-setuidgid x
s6-env HOME=/home/x
exec /opt/chatbox/serve.sh
