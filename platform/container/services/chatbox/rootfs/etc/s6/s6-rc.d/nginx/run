#!/opt/bm/profile/s6/bin/execlineb -P

s6-envdir -Lf -- /run/s6/container_environment

redirfd -w 1 /var/log/s6.nginx.log
fdmove -c 2 1

s6-setuidgid x
s6-env HOME=/home/x
s6-notifyoncheck -d -n 0 -w 1000 -t 2000 -T 30000
  -c "curl --noproxy * --fail --silent --output /dev/null --max-time 2 http://127.0.0.1:8080/healthz"
exec /opt/chatbox/serve.sh
