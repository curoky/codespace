#!/usr/bin/env bash

set -euo pipefail

scheduler_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

PYTHONPATH="$(cd -- "$scheduler_dir/.." && pwd)"
export PYTHONPATH

exec uv run \
  --project "$scheduler_dir" \
  --frozen \
  --no-sync \
  python -m scheduler.api \
  --config "$scheduler_dir/scheduler.yaml" \
  --host 0.0.0.0 \
  --port 8080 \
  "$@"
