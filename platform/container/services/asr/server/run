#!/usr/bin/env bash

set -euo pipefail

server_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

PYTHONPATH="$(cd -- "$server_dir/.." && pwd)"
export PYTHONPATH

exec uv run \
  --project "$server_dir" \
  --frozen \
  --no-sync \
  python -m server.api \
  --config "$server_dir/server.yaml" \
  --host 0.0.0.0 \
  --port 8080 \
  "$@"
