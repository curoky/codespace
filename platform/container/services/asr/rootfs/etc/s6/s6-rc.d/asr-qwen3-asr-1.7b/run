#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.asr-qwen3-asr-1.7b.log
fdmove -c 2 1

backtick -x CUDA_VISIBLE_DEVICES { cat /run/asr/qwen3-asr-1.7b/CUDA_VISIBLE_DEVICES }
backtick -x ASR_PORT { cat /run/asr/qwen3-asr-1.7b/PORT }

s6-setuidgid x
s6-env HOME=/home/x
/opt/asr/models/qwen3-asr-1.7b/run
