#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.asr-nemotron-diarization.log
fdmove -c 2 1

backtick -x CUDA_VISIBLE_DEVICES { cat /run/asr/nemotron-diarization/CUDA_VISIBLE_DEVICES }
backtick -x ASR_PORT { cat /run/asr/nemotron-diarization/PORT }

s6-setuidgid x
s6-env HOME=/home/x
/opt/asr/models/nemotron-diarization/run
