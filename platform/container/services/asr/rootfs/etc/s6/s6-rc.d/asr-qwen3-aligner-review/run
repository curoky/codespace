#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.asr-qwen3-aligner-review.log
fdmove -c 2 1

backtick -x CUDA_VISIBLE_DEVICES { cat /run/asr/qwen3-aligner-review/CUDA_VISIBLE_DEVICES }
backtick -x ASR_PORT { cat /run/asr/qwen3-aligner-review/PORT }

s6-setuidgid x
s6-env HOME=/home/x
/opt/asr/models/qwen3-aligner/run
