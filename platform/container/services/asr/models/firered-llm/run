#!/usr/bin/env bash

set -euo pipefail

model_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4

export CUDA_HOME=/usr/local/cuda-13.0
export CUDA_CACHE_PATH=/home/x/.cache/nv/ComputeCache
export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:/usr/local/cuda-13.0/lib64

# FP32 / TP=2 沿用作者对转换权重的部署配方；改精度或 TP 前须验证并同步 catalog.py。
# vLLM 从 processor 固定 30 秒输入；上层使用相同窗口边界，不传不支持的 server 级 ASR 配置。
exec uv run \
  --project "$model_dir" \
  --frozen \
  --no-sync \
  vllm serve \
  "$model_dir/weights" \
  --served-model-name firered-llm \
  --host 127.0.0.1 \
  --port "${ASR_PORT:?}" \
  --dtype float32 \
  --tensor-parallel-size 2 \
  --max-model-len 8192 \
  --gpu-memory-utilization 0.40 \
  --seed 0 \
  --generation-config vllm \
  "$@"
