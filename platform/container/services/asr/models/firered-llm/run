#!/usr/bin/env bash

set -euo pipefail

model_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4

export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat

# FP32 / TP=2 沿用作者对转换权重的部署配方；改精度或 TP 前须验证并同步 catalog.py。
# 8192 为短音频和中文输出留上下文；统一 30 秒窗口，并关闭 vLLM 再切片。
exec uv run \
  --project "$model_dir" \
  --frozen \
  --no-sync \
  vllm serve \
  "$model_dir/weights" \
  --served-model-name firered-llm \
  --host 127.0.0.1 \
  --port 8000 \
  --dtype float32 \
  --tensor-parallel-size 2 \
  --max-model-len 8192 \
  --gpu-memory-utilization 0.85 \
  --seed 0 \
  --generation-config vllm \
  --speech-to-text-config '{"max_audio_clip_s":30,"min_energy_split_window_size":null}' \
  "$@"
