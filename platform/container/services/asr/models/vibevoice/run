#!/usr/bin/env bash

set -euo pipefail

model_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export XDG_CACHE_HOME=/home/x/.cache
export VLLM_CACHE_ROOT=/home/x/.cache/vllm
export CUDA_CACHE_PATH=/home/x/.cache/nv/ComputeCache
export CUDA_CACHE_MAXSIZE=4294967296
export TORCH_EXTENSIONS_DIR=/home/x/.cache/torch_extensions
export VLLM_ENABLE_STARTUP_PLAN=1
export VLLM_MEDIA_LOADING_THREAD_COUNT=16
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export NUMEXPR_MAX_THREADS=8
export MAX_JOBS=24
export FLASHINFER_NVCC_THREADS=10
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

export CUDA_HOME=/usr/local/cuda-13.0
export FLASHINFER_WORKSPACE_BASE=/home/x/.cache/flashinfer-workspaces/vibevoice
export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:/usr/local/cuda-13.0/lib64

# HF checkpoint 使用原生 audio chat；固定模板补上 vLLM 不会替换的音频时长占位符。
# BF16 保留精度；65536 同时容纳音频 prompt 和上游 32768 token 生成预算。
exec uv run \
  --project "$model_dir" \
  --frozen \
  --no-sync \
  python "$model_dir/serve.py" \
  "$model_dir/weights" \
  --served-model-name vibevoice \
  --host 127.0.0.1 \
  --port "${ASR_PORT:?}" \
  --dtype bfloat16 \
  --tensor-parallel-size 1 \
  --chat-template "$model_dir/chat_template.jinja" \
  --max-model-len 65536 \
  --max-num-seqs 2 \
  --gpu-memory-utilization 0.60 \
  --model-loader-extra-config '{"enable_multithread_load":true,"num_threads":8}' \
  --seed 0 \
  --generation-config vllm \
  "$@"
