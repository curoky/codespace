#!/usr/bin/env bash

set -euo pipefail

model_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export XDG_CACHE_HOME=/home/x/.cache
export VLLM_CACHE_ROOT=/home/x/.cache/vllm
export CUDA_CACHE_PATH=/home/x/.cache/nv/ComputeCache
export CUDA_CACHE_MAXSIZE=4294967296
export TORCH_EXTENSIONS_DIR=/home/x/.cache/torch_extensions
export VLLM_ENABLE_STARTUP_PLAN=1
export VLLM_MEDIA_LOADING_THREAD_COUNT=16
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export NUMEXPR_MAX_THREADS=8
export MAX_JOBS=24
export FLASHINFER_NVCC_THREADS=10

PYTHONPATH="$(cd -- "$model_dir/../.." && pwd)"
export PYTHONPATH
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYANNOTE_METRICS_ENABLED=0
export TOKENIZERS_PARALLELISM=false

export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat

exec uv run \
  --project "$model_dir" \
  --frozen \
  --no-sync \
  uvicorn service:app \
  --factory \
  --app-dir "$model_dir" \
  --host 127.0.0.1 \
  --port "${ASR_PORT:?}" \
  --workers 1 \
  "$@"
