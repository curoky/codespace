#!/usr/local/bin/execlineb -P

redirfd -w 1 /var/log/s6.asr-pyannote-community-1.log
fdmove -c 2 1

backtick -x CUDA_VISIBLE_DEVICES { cat /run/asr/pyannote-community-1/CUDA_VISIBLE_DEVICES }
backtick -x ASR_PORT { cat /run/asr/pyannote-community-1/PORT }

s6-setuidgid x
s6-env HOME=/home/x
/opt/asr/models/pyannote-community-1/run
