#!/usr/bin/env bash

set -euo pipefail

model_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4

export CUDA_HOME=/usr/local/cuda-13.0
export CUDA_CACHE_PATH=/home/x/.cache/nv/ComputeCache
export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:/usr/local/cuda-13.0/lib64

# BF16 保留原精度；8192 包含音频编码与输出预算，不是音频秒数。
# vLLM 从 processor 固定 30 秒输入；上层使用相同窗口边界。
exec uv run \
  --project "$model_dir" \
  --frozen \
  --no-sync \
  vllm serve \
  "$model_dir/weights" \
  --served-model-name qwen3-asr-1.7b \
  --host 127.0.0.1 \
  --port "${ASR_PORT:?}" \
  --dtype bfloat16 \
  --tensor-parallel-size 1 \
  --max-model-len 8192 \
  --gpu-memory-utilization 0.15 \
  --seed 0 \
  --generation-config vllm \
  "$@"
