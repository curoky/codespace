#!/usr/bin/env bash

set -euo pipefail

model_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export XDG_CACHE_HOME=/home/x/.cache
export VLLM_CACHE_ROOT=/home/x/.cache/vllm
export CUDA_CACHE_PATH=/home/x/.cache/nv/ComputeCache
export CUDA_CACHE_MAXSIZE=4294967296
export TORCH_EXTENSIONS_DIR=/home/x/.cache/torch_extensions
export VLLM_ENABLE_STARTUP_PLAN=1
export VLLM_MEDIA_LOADING_THREAD_COUNT=16
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export NUMEXPR_MAX_THREADS=8
export MAX_JOBS=24
export FLASHINFER_NVCC_THREADS=10
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

export CUDA_HOME=/usr/local/cuda-13.0
export FLASHINFER_WORKSPACE_BASE=/home/x/.cache/flashinfer-workspaces/qwen3-asr-1.7b
export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:/usr/local/cuda-13.0/lib64

# BF16 保留原精度；8192 包含音频编码与输出预算，不是音频秒数。
# vLLM 从 processor 固定 30 秒输入；上层使用相同窗口边界。
export PYTHONPATH="$model_dir/../.."

exec uv run \
  --project "$model_dir" \
  --frozen \
  --no-sync \
  python "$model_dir/api.py" vllm serve \
  "$model_dir/weights" \
  --served-model-name qwen3-asr-1.7b \
  --host 127.0.0.1 \
  --port "$((ASR_PORT + 1000))" \
  --dtype bfloat16 \
  --tensor-parallel-size 1 \
  --max-model-len 8192 \
  --max-num-seqs 2 \
  --gpu-memory-utilization 0.15 \
  --model-loader-extra-config '{"enable_multithread_load":true,"num_threads":8}' \
  --seed 0 \
  --generation-config vllm \
  "$@"
