; Windows-side keep-alive for the codespace WSL distribution.
;
; Merge these into  C:\Users\<you>\.wslconfig  (create it if absent), then run
; `wsl --shutdown` and start the distro again. This file lives on Windows and
; canNOT be baked into the exported rootfs.
;
; Why this is required: a WSL distribution is auto-terminated ~15s after its
; last tracked session process exits. Processes started by [boot] command (our
; s6-svscan + sshd) do NOT count as keep-alive, so without this the distribution --
; and sshd with it -- is reaped whenever no interactive terminal is open, and a
; LAN client (macOS) can no longer connect.
;
; There are two independent timers; set both to disable auto-shutdown:

[general]
; Distribution idle timer (ms). Default 15000 -- this is the 15s reaper.
; -1 disables it. This is the key that actually keeps sshd reachable.
; NOTE: instanceIdleTimeout is a newer WSL key (documented 2026-04). Older WSL
;       silently ignores it -- verify with `wsl --version` and the check below.
instanceIdleTimeout=-1

[wsl2]
; VM idle timer (ms). Default 60000. Keeps the shared VM (vmmem) alive.
; -1 = never. Alone it is NOT enough (it keeps the VM, not the distribution).
vmIdleTimeout=-1

; Verify keep-alive works:
;   1. wsl --shutdown
;   2. wsl -d codespace -- true     (start the distribution)
;   3. close every terminal, wait ~30s
;   4. wsl -l -v                    (codespace should still show "Running")
; If it shows "Stopped", your WSL build does not honor instanceIdleTimeout;
; use windows/setup-keepalive.ps1 instead.
